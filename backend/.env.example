DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# JSON log threshold: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

POSTGRES_DB=lumenza
POSTGRES_USER=lumenza
POSTGRES_PASSWORD=lumenza
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Providers / billing (Phase 1). Leave OPENAI_API_KEY empty for local dev —
# the adapter falls back to a deterministic mock response with no real cost.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
# NVIDIA NIM (Phase 11) — one key for the whole build.nvidia.com/models
# catalog. Leave empty for local dev; adapter falls back to a mock response.
NVIDIA_API_KEY=

# 1 credit = $0.001 of underlying provider cost (before markup).
CREDIT_USD_VALUE=0.001
# Applied on top of raw provider cost before converting to credits.
PROVIDER_MARKUP=1.3
# Welcome credits granted on signup (~$0.50 of usage at default markup).
SIGNUP_BONUS_CREDITS=500

# Telegram bot (Phase 5). Leave TELEGRAM_BOT_TOKEN empty to leave the bot
# service idle — get a token from @BotFather to actually run it.
TELEGRAM_BOT_TOKEN=
# Only used for the production webhook path (bot/views.py); the local dev
# `bot` docker-compose service runs long-polling instead and ignores these.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
# @username of the bot (no leading @) — needed for correct t.me/... links
# (referrals) and for the Telegram Login Widget on the website.
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL of the frontend, registered as a Mini App in BotFather
# (/newapp). Leave empty to keep the bot's "Open App" button/menu hidden.
MINI_APP_URL=

# YooKassa (Phase 6). Leave empty to leave real top-up unavailable — get
# shopId/secretKey from a (test-mode is fine) YooKassa account.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 credit = this many RUB.
CREDIT_RUB_VALUE=0.1

# Only set this to true once a real TLS-terminating reverse proxy (nginx/
# Caddy/load balancer) sits in front of this deploy — see lumenza/settings.py
# for why (turns on Secure cookies, HSTS, and forced HTTPS redirect, all of
# which break a plain-HTTP deploy).
TLS_TERMINATED=false
# Origin(s) of the Next.js frontend(s) this backend is proxied behind (see
# frontend/src/proxy.ts) — needed for CSRF's Origin check on real browser
# requests. Comma-separated for multiple (e.g. a staging + prod frontend).
PUBLIC_FRONTEND_ORIGINS=http://localhost:3000
